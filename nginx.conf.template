# Nginx serves the static frontend and forwards /api to the backend and /auth to Keycloak,
# so the browser sees one origin (no CORS). The nginx image fills ${BACKEND_URL} and
# ${KEYCLOAK_URL} from the environment at startup.

# Keep https when a tunnel in front of us already terminated TLS.
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # $http_host keeps the port (localhost:8090), which Keycloak needs to build its own URLs.
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;

    location /api/ {
        proxy_pass ${BACKEND_URL};
    }

    # Keycloak: only the realm endpoints (login, registration, tokens, account) and their
    # static resources are public. The admin console is not proxied.
    location ~ ^/auth/(realms|resources)/ {
        proxy_pass ${KEYCLOAK_URL};
        # Login responses carry large cookies.
        proxy_buffer_size 128k;
        proxy_buffers 4 256k;
        proxy_busy_buffers_size 256k;
    }

    # Everything else under /auth (e.g. the admin console) does not exist from outside.
    location /auth/ {
        return 404;
    }

    location / {
        # The browser may keep the files but must ask whether they changed (no stale JS/CSS).
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
